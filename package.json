{
  "name": "authoro",
  "private": true,
  "description": "Authoro: the public provenance registry for authorship and creative work.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @authoro/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @authoro/web db:generate",
    "db:migrate": "pnpm --filter @authoro/web db:migrate",
    "db:studio": "pnpm --filter @authoro/web db:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
