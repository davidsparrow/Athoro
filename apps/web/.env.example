# Postgres connection string. `docker compose up -d` from the repo root starts one matching this.
DATABASE_URL=postgresql://authoro:authoro@localhost:5432/authoro

# Used by integration tests; they run migrations against this database and truncate it.
TEST_DATABASE_URL=postgresql://authoro:authoro@localhost:5432/authoro_test

# Session signing secret, at least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-000000

# Public origin of this deployment, used for auth callbacks and absolute proof URLs.
# On Vercel it may be left unset: production then uses the project's domain and
# previews their own URL (see docs/deploy.md).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email via Resend (https://resend.com). Leave unset in development
# to print emails, including verification and sign-in links, to the server console.
# RESEND_API_KEY=
# Sender address; its domain must be verified in Resend.
EMAIL_FROM=Authoro <no-reply@authoro.net>

# Every account gets Pro features (private, unlisted and embargoed records) until
# billing exists. For development, and for self-hosted instances without billing.
# AUTHORO_ALL_PRO=true

# Vercel Cron sends this as a bearer token to /api/cron/embargoes, which records
# embargo releases and emails authors. Generate one with: openssl rand -base64 32
# CRON_SECRET=
